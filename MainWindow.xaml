<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PTTK.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PTTK"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d"
    Title="PTTTK - Benchmark Pipeline Test">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Control bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center">
            <Button x:Name="RunButton" Content="Run" Click="OnRunClick"/>
            <Button x:Name="StopButton" Content="Stop" Click="OnStopClick"
                    IsEnabled="False"/>
            <TextBlock x:Name="StatusText" Text="Ready"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Win2D chart surface -->
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <canvas:CanvasControl x:Name="SortCanvas"
                                  Draw="SortCanvas_Draw"
                                  ClearColor="White"/>
        </Border>

        <!-- Live legend -->
        <TextBlock Grid.Row="2" x:Name="LegendText"
                   FontFamily="Consolas" TextWrapping="Wrap" Text=""/>
    </Grid>
</Window>
