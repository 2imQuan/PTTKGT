<Window
    x:Class="AlgorithmBenchmarkTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlgorithmBenchmarkTool"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid ColumnDefinitions="320,*" Padding="16" ColumnSpacing="16">

        <!-- ===== Cot trai: controls cua Nguoi 5 (giu nguyen ten) ===== -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10">

                <TextBlock Text="Algorithm Benchmark Tool" FontSize="24"/>

                <TextBlock Text="Data Type"/>
                <ComboBox x:Name="DataTypeBox" HorizontalAlignment="Stretch"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Random"/>
                    <ComboBoxItem Content="Sorted"/>
                    <ComboBoxItem Content="Reversed"/>
                    <ComboBoxItem Content="Partial"/>
                </ComboBox>

                <TextBlock Text="Data Size"/>
                <Slider x:Name="SizeSlider" Minimum="100" Maximum="10000"
                        Value="1000" StepFrequency="100"/>
                <TextBlock x:Name="SizeText" Text="Size: 1000"/>

                <TextBlock Text="Algorithms" Margin="0,8,0,0"/>
                <CheckBox x:Name="BubbleBox"    Content="Bubble Sort"    IsChecked="True"/>
                <CheckBox x:Name="InsertionBox" Content="Insertion Sort" IsChecked="True"/>
                <CheckBox x:Name="QuickBox"     Content="Quick Sort"     IsChecked="True"/>
                <CheckBox x:Name="MergeBox"     Content="Merge Sort"     IsChecked="True"/>
                <CheckBox x:Name="ShellBox"     Content="Shell Sort"     IsChecked="True"/>

                <TextBlock Text="Display" Margin="0,8,0,0"/>
                <CheckBox x:Name="AutoScaleBox" Content="Auto-scale tung panel"
                          IsChecked="False"/>
                <CheckBox x:Name="SlowMoBox"    Content="Slow-mo (demo)"
                          IsChecked="False"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="RunButton"  Content="RUN"  Click="RunButton_Click"/>
                    <Button x:Name="StopButton" Content="STOP" Click="StopButton_Click"
                            IsEnabled="False"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,4,0,0"/>

                <TextBlock Text="Results" Margin="0,8,0,0"/>
                <ListView x:Name="ResultList" Height="180"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Cot phai: chart real-time (Nguoi 6) ===== -->
        <Border Grid.Column="1" BorderThickness="1" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Padding="12,8" Spacing="2">
                    <TextBlock Text="Real-time Benchmark Chart" FontSize="16"/>
                    <TextBlock Text="Colored line = comparisons   |   Black line = swaps"
                               FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="Y axis = operation count   |   X axis = progress over time"
                               FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="DataInfoText" Text="Data: (press RUN)"
                               FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <canvas:CanvasControl x:Name="SortCanvas" Grid.Row="1"
                                      Draw="SortCanvas_Draw"
                                      ClearColor="White" Margin="8"/>
            </Grid>
        </Border>

    </Grid>

</Window>
